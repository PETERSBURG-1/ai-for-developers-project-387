{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "railway": {
        "type": "remote",
        "url": "https://mcp.railway.app/mcp"
      }
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "/tmp/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    }
  ]
}
